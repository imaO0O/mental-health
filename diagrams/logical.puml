@startuml logical
' =====================================================================
' Рисунок 3 — Логическая модель данных (реляционная).
' Логическая модель фиксирует ТО, ЧТО ХРАНИТСЯ в базе: отношения,
' их атрибуты, потенциальные (PK) и внешние (FK) ключи и связи между
' отношениями. Типы данных на логическом уровне НЕ указываются — они
' добавляются на физической модели (см. physical.puml, рисунок 17).
' Имена сущностей — в единственном числе; расположение отношений
' повторяет компоновку концептуальной модели (рисунок 2):
'   • справочники-словари (Роль, Категория теста, Уровень стресса, Статус)
'   • учётные записи и профили (Пользователь, Студент, Психолог, Специализация)
'   • тесты и вопросы (Тест, Вопрос, Вариант ответа)
'   • прохождение тестов (Протокол тестирования, Ответ пользователя)
'   • сопровождение (Рекомендация, Заметка психолога, Журнал аудита)
' ELK-layout даёт меньше пересечений линий, чем стандартный dot.
' =====================================================================

!pragma layout elk

top to bottom direction

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam linetype ortho
skinparam ranksep 70
skinparam nodesep 70
skinparam padding 4

skinparam class {
    BackgroundColor       White
    BorderColor           Black
    FontColor             Black
    ArrowColor            #444444
    ArrowFontColor        Black
    ArrowFontSize         10
    HeaderBackgroundColor #EEF0FB
    AttributeFontColor    Black
}

hide circle

' ===== ДОМЕН: справочники-словари =====
together {
  entity "Роль" as Roles {
      * <u>Название роли</u>  <<PK>>
      --
        Описание
  }

  entity "Категория теста" as Categories {
      * <u>Название категории</u>  <<PK>>
      --
        Описание
  }

  entity "Уровень стресса" as StressLevels {
      * <u>Название уровня</u>  <<PK>>
      --
      * Минимальный процент
      * Максимальный процент
  }

  entity "Статус прохождения" as Statuses {
      * <u>Название статуса</u>  <<PK>>
      --
        Описание
  }
}

' ===== ДОМЕН: учётные записи и профили =====
together {
  entity "Пользователь" as Users {
      * <u>Логин</u>  <<PK>>
      --
      * Хэш пароля
      * Название роли  <<FK>>
        Дата создания
  }

  entity "Студент" as Students {
      * <u>Номер зачётной книжки</u>  <<PK>>
      --
      * Логин  <<FK>>
      * Фамилия
      * Имя
        Отчество
      * Группа
        Электронная почта
        Телефон
  }

  entity "Психолог" as Psychologists {
      * <u>Табельный номер</u>  <<PK>>
      --
      * Логин  <<FK>>
      * Фамилия
      * Имя
        Отчество
        Должность
        Электронная почта
        Телефон
  }

  entity "Специализация\nпсихолога" as Specs {
      * <u>Табельный номер</u>  <<PK,FK>>
      * <u>Название категории</u>  <<PK,FK>>
  }
}

' ===== ДОМЕН: тесты и вопросы =====
together {
  entity "Тест" as Tests {
      * <u>Шифр теста</u>  <<PK>>
      --
      * Название
        Описание
        Инструкции
        Активен
        Автор (Табельный номер)  <<FK>>
        Название категории  <<FK>>
  }

  entity "Вопрос" as Questions {
      * <u>Номер вопроса</u>  <<PK>>
      --
      * Шифр теста  <<FK>>
      * Текст вопроса
      * Порядковый номер
  }

  entity "Вариант ответа" as Answers {
      * <u>Код варианта ответа</u>  <<PK>>
      --
      * Номер вопроса  <<FK>>
      * Текст ответа
      * Балл
      * Порядковый номер
  }
}

' ===== ДОМЕН: прохождение тестов =====
together {
  entity "Протокол\nтестирования" as Protocols {
      * <u>Номер протокола</u>  <<PK>>
      --
      * Номер зачётной книжки  <<FK>>
      * Шифр теста  <<FK>>
      * Дата и время прохождения
      * Суммарный балл
        Название уровня  <<FK>>
        Название статуса  <<FK>>
  }

  entity "Ответ пользователя" as UserAnswers {
      * <u>Номер записи ответа</u>  <<PK>>
      --
      * Номер протокола  <<FK>>
      * Номер вопроса  <<FK>>
      * Код варианта ответа  <<FK>>
  }
}

' ===== ДОМЕН: сопровождение =====
together {
  entity "Рекомендация" as Recs {
      * <u>Код рекомендации</u>  <<PK>>
      --
      * Название уровня  <<FK>>
      * Текст рекомендации
        Порядковый номер
        Автор (Табельный номер)  <<FK>>
  }

  entity "Заметка психолога" as Notes {
      * <u>Номер заметки</u>  <<PK>>
      --
      * Табельный номер  <<FK>>
      * Номер зачётной книжки  <<FK>>
      * Дата заметки
      * Текст заметки
  }

  entity "Журнал аудита" as Audit {
      * <u>Номер записи аудита</u>  <<PK>>
      --
      * Время операции
        Логин  <<FK>>
      * Тип операции
      * Имя таблицы
        Подробности
  }
}

' ===== Связи =====
' Авторизация
Roles        ||--o{ Users        : "1..N"
Users        ||--o| Students     : "1..1"
Users        ||--o| Psychologists: "1..1"
Users        ||--o{ Audit        : "1..N"

' Специализации
Psychologists ||--o{ Specs       : "1..N"
Categories    ||--o{ Specs       : "1..N"

' Тесты
Categories    ||--o{ Tests       : "1..N"
Psychologists ||--o{ Tests       : "1..N"
Tests         ||--o{ Questions   : "1..N"
Questions     ||--o{ Answers     : "1..N"

' Прохождение
Students     ||--o{ Protocols    : "1..N"
Tests        ||--o{ Protocols    : "1..N"
StressLevels ||--o{ Protocols    : "1..N"
Statuses     ||--o{ Protocols    : "1..N"
Protocols    ||--o{ UserAnswers  : "1..N"
Questions    ||--o{ UserAnswers  : "1..N"
Answers      ||--o{ UserAnswers  : "1..N"

' Сопровождение
StressLevels  ||--o{ Recs        : "1..N"
Psychologists ||--o{ Recs        : "1..N"
Psychologists ||--o{ Notes       : "1..N"
Students      ||--o{ Notes       : "1..N"

@enduml
