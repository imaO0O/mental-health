@startuml logical
' =====================================================================
' Рисунок 3 — Логическая модель данных (реляционная).
' Логическая модель фиксирует ТО, ЧТО ХРАНИТСЯ в базе: отношения,
' их атрибуты, потенциальные (PK) и внешние (FK) ключи и связи.
' Типы данных НЕ указываются — они добавляются на физической модели.
' Имена сущностей — в единственном числе.
'   • справочники-словари (Роль, Показатель, Градация)
'   • учётные записи и профили (Пользователь, Психолог, Студент, Специализация психолога)
'   • тесты и их содержание (Тест, Вопрос, Вариант ответа)
'   • прохождение тестов (Протокол тестирования, Результат по пункту — составной ключ)
'   • сопровождение (Рекомендация, Заметка по тестированию, Консультация, Журнал аудита)
' =====================================================================

!pragma layout elk

top to bottom direction

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam linetype ortho
skinparam ranksep 70
skinparam nodesep 70
skinparam padding 4

skinparam class {
    BackgroundColor       White
    BorderColor           Black
    FontColor             Black
    ArrowColor            #444444
    ArrowFontColor        Black
    ArrowFontSize         10
    HeaderBackgroundColor #EEF0FB
    AttributeFontColor    Black
}

hide circle

' ===== ДОМЕН: справочники-словари =====
together {
  entity "Роль" as Roles {
      * <u>Название роли</u>  <<PK>>
      --
        Описание
  }

  entity "Показатель" as Indicators {
      * <u>Название показателя</u>  <<PK>>
      --
        Описание
  }

  entity "Градация" as Grades {
      * <u>Название градации</u>  <<PK>>
      --
      * Минимальный процент
      * Максимальный процент
  }
}

' ===== ДОМЕН: учётные записи и профили =====
together {
  entity "Пользователь" as Users {
      * <u>Логин</u>  <<PK>>
      --
      * Хэш пароля
      * Название роли  <<FK>>
        Дата создания
  }

  entity "Психолог" as Psychologists {
      * <u>Табельный номер</u>  <<PK>>
      --
      * Логин  <<FK>>
      * Фамилия
      * Имя
        Отчество
        Специализация
        Электронная почта
        Телефон
  }

  entity "Студент" as Students {
      * <u>Номер зачётной книжки</u>  <<PK>>
      --
      * Логин  <<FK>>
      * Фамилия
      * Имя
        Отчество
      * Группа
        Психологический тип
        Группа риска
        Табельный номер куратора  <<FK>>
        Электронная почта
        Телефон
  }

  entity "Специализация\nпсихолога" as Specs {
      * <u>Табельный номер</u>  <<PK,FK>>
      * <u>Название показателя</u>  <<PK,FK>>
  }
}

' ===== ДОМЕН: тесты и их содержание =====
together {
  entity "Тест" as Tests {
      * <u>Шифр теста</u>  <<PK>>
      --
      * Название
        Описание
        Инструкция
        Название показателя  <<FK>>
        Автор (Табельный номер)  <<FK>>
  }

  entity "Вопрос" as Questions {
      * <u>Номер вопроса</u>  <<PK>>
      --
      * Шифр теста  <<FK>>
      * Текст вопроса
      * Порядковый номер
  }

  entity "Вариант ответа" as Answers {
      * <u>Код варианта ответа</u>  <<PK>>
      --
      * Номер вопроса  <<FK>>
      * Текст ответа
      * Балл
      * Порядковый номер
  }
}

' ===== ДОМЕН: прохождение тестов =====
together {
  entity "Протокол\nтестирования" as Protocols {
      * <u>Номер протокола</u>  <<PK>>
      --
      * Номер зачётной книжки  <<FK>>
      * Шифр теста  <<FK>>
      * Дата и время прохождения
      * Суммарный балл
        Заключение (Название градации)  <<FK>>
  }

  entity "Результат по пункту" as ItemResults {
      * <u>Номер протокола</u>  <<PK,FK>>
      * <u>Номер вопроса</u>  <<PK,FK>>
      --
      * Код варианта ответа  <<FK>>
  }
}

' ===== ДОМЕН: сопровождение =====
together {
  entity "Рекомендация" as Recs {
      * <u>Код рекомендации</u>  <<PK>>
      --
      * Название градации  <<FK>>
      * Текст рекомендации
        Порядковый номер
        Автор (Табельный номер)  <<FK>>
  }

  entity "Заметка по\nтестированию" as TestNotes {
      * <u>Номер заметки</u>  <<PK>>
      --
      * Табельный номер  <<FK>>
      * Номер протокола  <<FK>>
      * Дата заметки
      * Текст заметки
  }

  entity "Консультация" as Consultations {
      * <u>Номер консультации</u>  <<PK>>
      --
      * Табельный номер  <<FK>>
      * Номер зачётной книжки  <<FK>>
      * Дата консультации
      * Текст беседы
  }

  entity "Журнал аудита" as Audit {
      * <u>Номер записи аудита</u>  <<PK>>
      --
      * Время операции
        Логин  <<FK>>
      * Тип операции
      * Имя таблицы
        Подробности
  }
}

' ===== Связи =====
' Авторизация
Roles         ||--o{ Users         : "1..N"
Users         ||--o| Students      : "1..1"
Users         ||--o| Psychologists : "1..1"
Users         ||--o{ Audit         : "1..N"

' Кураторство и специализации
Psychologists ||--o{ Students      : "курирует 1..N"
Psychologists ||--o{ Specs         : "1..N"
Indicators    ||--o{ Specs         : "1..N"

' Тесты и содержание
Indicators    ||--o{ Tests         : "1..N"
Psychologists ||--o{ Tests         : "1..N"
Tests         ||--o{ Questions     : "1..N"
Questions     ||--o{ Answers       : "1..N"

' Прохождение
Students      ||--o{ Protocols     : "1..N"
Tests         ||--o{ Protocols     : "1..N"
Grades        ||--o{ Protocols     : "1..N"
Protocols     ||--o{ ItemResults   : "1..N"
Questions     ||--o{ ItemResults   : "1..N"
Answers       ||--o{ ItemResults   : "1..N"

' Сопровождение
Grades        ||--o{ Recs          : "1..N"
Psychologists ||--o{ Recs          : "1..N"
Psychologists ||--o{ TestNotes     : "1..N"
Protocols     ||--o{ TestNotes     : "1..N"
Psychologists ||--o{ Consultations : "1..N"
Students      ||--o{ Consultations : "1..N"

@enduml
